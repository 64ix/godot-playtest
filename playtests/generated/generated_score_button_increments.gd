extends PlaytestCase

func test_generated_score_button_increments() -> void:
	await start_game("res://fixtures/witness_game/main.tscn")

	await assert_now_property({"test_id": "score_label"}, "text", "0")
	press({"test_id": "score_button"})
	await wait_for({"test_id": "score_label"}, {"property": "text", "equals": "1", "timeout_ms": 3000})
	await assert_eventually_property({"test_id": "score_label"}, "text", "1")
