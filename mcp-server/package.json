{
  "name": "godot-playtest-mcp",
  "version": "0.1.1",
  "description": "Thin proxy MCP server to the godot-playtest Bridge: tools 1:1 with the protocol's verbs (docs/protocol/DRAFT-v0.md), plus launch_game/attach.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/64ix/godot-playtest.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/64ix/godot-playtest/tree/main/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/64ix/godot-playtest/issues"
  },
  "keywords": [
    "godot",
    "mcp",
    "model-context-protocol",
    "playtest",
    "testing",
    "ai-agent"
  ],
  "bin": {
    "godot-playtest-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepack": "npm run build && node scripts/copy-license.mjs",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "test:all": "node --import tsx --test test/unit/*.test.ts test/integration/*.test.ts",
    "generate:golden-freeze": "npm run build && node scripts/generate-golden-freeze.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
