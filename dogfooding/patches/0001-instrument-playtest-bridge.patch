diff --git a/player/player.gd b/player/player.gd
index 42b6c3d..9ca406c 100644
--- a/player/player.gd
+++ b/player/player.gd
@@ -23,6 +23,35 @@ var motion := Vector2()
 
 @onready var initial_position: Vector3 = transform.origin
 
+## godot-playtest dogfooding (issue #14): a real property (not only
+## inside `_test_state()`) so that `assert_property` (which reads `node.get(...)`,
+## §7 of the protocol) can target a domain value directly, without
+## depending on the absolute position (non-deterministic, spawn shuffle — see
+## dogfooding/FRICTIONS.md).
+var distance_from_spawn: float = 0.0
+
+const MOVED_THRESHOLD_METERS: float = 2.0
+
+## `wait_for`/`assert_property` only compare by strict equality (§4/§7 of the
+## protocol): a threshold boolean, not a float to compare, is the idiomatic
+## form for a domain assertion "the player has moved".
+var has_moved: bool = false
+
+## godot-playtest (issue #17): aim telemetry — pattern "the game exposes
+## what it already computes" (dogfooding/INSTRUMENTATION.md). `player_input.gd`
+## already computes, every aim frame, the camera→world raycast through the
+## crosshair's center (`shoot_target`); these two properties republish the
+## result in domain terms directly on the player, real properties (like
+## `has_moved`) so that `assert_property` can read them without going through `state`:
+## - `aim_target_test_id`: test_id of the node currently under the crosshair
+##   ("" if none, or out of aim) — a frozen test can assert "the target is in the
+##   crosshair" with just this field, without rebuilding the camera/target geometry.
+## - `aim_target_position`: the raycast's impact point (mirrors
+##   `shoot_target`), useful for diagnostics (`query`) but never compared by
+##   strict equality (position float, cf. `has_moved` above).
+var aim_target_test_id: String = ""
+var aim_target_position: Vector3 = Vector3()
+
 @onready var player_input: PlayerInputSynchronizer = $InputSynchronizer
 @onready var animation_tree: AnimationTree = $AnimationTree
 @onready var player_model: Node3D = $PlayerModel
@@ -51,6 +80,21 @@ func _ready() -> void:
 		set_process(false)
 
 
+## godot-playtest dogfooding (issue #14): domain `_test_state()` — position
+## and distance traveled since spawn (useful because `player_spawn_points` is
+## shuffled at startup, see dogfooding/FRICTIONS.md: the absolute position
+## is not deterministic from one run to another, the distance traveled is).
+func _test_state() -> Dictionary:
+	return {
+		"position": transform.origin,
+		"distance_from_spawn": distance_from_spawn,
+		"has_moved": has_moved,
+		"airborne_time": airborne_time,
+		"aim_target_test_id": aim_target_test_id,
+		"aim_target_position": aim_target_position,
+	}
+
+
 func _physics_process(delta: float) -> void:
 	if multiplayer.is_server():
 		apply_input(delta)
@@ -171,6 +215,22 @@ func apply_input(delta: float) -> void:
 
 	player_model.global_transform.basis = orientation.basis
 
+	# godot-playtest dogfooding (issue #14): maintained every server frame,
+	# read by assert_property/_test_state (see declaration above).
+	distance_from_spawn = transform.origin.distance_to(initial_position)
+	if distance_from_spawn >= MOVED_THRESHOLD_METERS:
+		has_moved = true
+
+	# godot-playtest (issue #17): aim telemetry republished from
+	# `player_input` (see declaration above) — the game, not the test,
+	# resolves the node under the crosshair into a test_id.
+	aim_target_position = player_input.shoot_target
+	var target: Object = player_input.aim_target_collider
+	if target != null and is_instance_valid(target) and (target as Node).has_meta("test_id"):
+		aim_target_test_id = String((target as Node).get_meta("test_id"))
+	else:
+		aim_target_test_id = ""
+
 	# If we're below -40, respawn (teleport to the initial position).
 	if transform.origin.y < -40.0:
 		transform.origin = initial_position
