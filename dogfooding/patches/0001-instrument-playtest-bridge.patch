@@ -83,16 +89,34 @@ func _process(delta: float) -> void:
 		jump.rpc()
 
 	shooting = Input.is_action_pressed("shoot")
-	if shooting:
+	# godot-playtest (issue #17): the camera→world raycast through the crosshair's
+	# center (already computed here for `shoot_target`) now runs for as long
+	# as the player aims (`aiming`), not just at the moment the shot fires —
+	# a frozen test can thus read, via the player's `_test_state()`, the target
+	# currently under the crosshair *before* semantically triggering the shot,
+	# without recomputing the camera/target trigonometry on the test script side. Does not
+	# change the bullets' trajectory (still read at the moment of firing,
+	# state_first — see dogfooding/FRICTIONS.md, friction #2 "3D selectors").
+	if aiming:
 		var ch_pos = crosshair.position + crosshair.size * 0.5
 		var ray_from = camera_camera.project_ray_origin(ch_pos)
 		var ray_dir = camera_camera.project_ray_normal(ch_pos)
 
-		var col = get_parent().get_world_3d().direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create(ray_from, ray_from + ray_dir * 1000, 0b11, Array([self], TYPE_RID, "", null)))
+		# godot-playtest (issue #17): excludes the player itself (`get_parent()`,
+		# the `CharacterBody3D`) — the original code passed `self` (this
+		# `MultiplayerSynchronizer`, with no physics RID), a no-op that left the
+		# camera ending up "under the crosshair" of itself whenever an aim
+		# angle pointed at its own body (visible continuously now that this
+		# raycast runs throughout aiming, not just when firing).
+		var col = get_parent().get_world_3d().direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create(ray_from, ray_from + ray_dir * 1000, 0b11, Array([get_parent()], TYPE_RID, "", null)))
 		if col.is_empty():
 			shoot_target = ray_from + ray_dir * 1000.0
+			aim_target_collider = null
 		else:
 			shoot_target = col.position
+			aim_target_collider = col.collider
+	else:
+		aim_target_collider = null
 
 	# Fade out to black if falling out of the map. -17 is lower than
 	# the lowest valid position checked the map (which is a bit under -16).
