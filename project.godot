config_version=5

[application]

config/name="godot-playtest"
config/description="Permanent witness game for the repo: fixture for the godot-playtest protocol conformance suite."
run/main_scene="res://fixtures/witness_game/main.tscn"
config/features=PackedStringArray("4.6")

[autoload]

TestBridge="*res://addons/playtest/bridge.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
